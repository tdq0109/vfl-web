# Chép tệp này thành .env.local và điền giá trị thật.
# .env.local bị .gitignore bỏ qua — không commit token/địa chỉ nội bộ.

# Địa chỉ gốc của backend .NET. CHỈ đọc ở server (src/lib/server/dotnet.ts).
# Không thêm tiền tố NEXT_PUBLIC_ — client không được biết địa chỉ này.
DOTNET_API_URL=http://localhost:5099
